# Variables base para Docker Compose y Spring Boot
# Copia este archivo a .env y ajusta los valores para Kinetic.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=kinetic_pos
MYSQL_USER=kinetic_user
MYSQL_PASSWORD=change-me-user

# Backend
DB_HOST=mysql
DB_PORT=3306
DB_NAME=kinetic_pos
DB_USER=kinetic_user
DB_PASSWORD=change-me-user
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/kinetic_pos?useSSL=false&serverTimezone=America/Lima&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=kinetic_user
SPRING_DATASOURCE_PASSWORD=change-me-user
SPRING_PORT=8080
TIME_ZONE=America/Lima
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQL=WARN
SPRING_PROFILES_ACTIVE=dev

# JWT
# Debe ser una cadena base64 larga y unica.
JWT_SECRET=change-me-base64-secret
JWT_EXPIRATION=86400000

# Usuario administrador inicial
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@kinetic.local
ADMIN_PASSWORD=ChangeMe123!
